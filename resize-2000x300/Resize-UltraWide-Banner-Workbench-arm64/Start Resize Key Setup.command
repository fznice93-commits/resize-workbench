#!/bin/zsh
set -eu
SCRIPT_DIR="${0:A:h}"
cd "$SCRIPT_DIR"
export RESIZE_REAL_PROVIDER_ENABLED=0
export RESIZE_KEY_SETUP_ONLY=1
export RESIZE_DATA_NAMESPACE=KEY_SETUP
export RESIZE_RUN_MODE=PRODUCTION
export RESIZE_ENABLE_PRODUCTION_KEYCHAIN=EXPLICITLY_AUTHORIZED
export RESIZE_PRODUCT_MODE=KEY_SETUP
export RESIZE_FAKE_MODE=0
exec /bin/zsh "$SCRIPT_DIR/scripts/launch-key-setup.zsh"
