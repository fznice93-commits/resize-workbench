#!/bin/zsh
set -eu
SCRIPT_DIR="${0:A:h}"
cd "$SCRIPT_DIR"
export RESIZE_REAL_PROVIDER_ENABLED=0
export RESIZE_ENABLE_PRODUCTION_KEYCHAIN=0
export RESIZE_FAKE_MODE=1
export RESIZE_RUN_MODE=PRODUCTION_PREVIEW
export RESIZE_PRODUCT_MODE=PRODUCTION_PREVIEW
export RESIZE_DATA_NAMESPACE=PRODUCTION_PREVIEW
exec /bin/zsh "$SCRIPT_DIR/scripts/launch-production-preview.zsh"
