#!/bin/zsh
set -eu
SCRIPT_DIR="${0:A:h}"
cd "$SCRIPT_DIR"
export RESIZE_RUN_MODE=PRODUCTION
export RESIZE_ENABLE_PRODUCTION_KEYCHAIN=EXPLICITLY_AUTHORIZED
export RESIZE_REAL_PROVIDER_ENABLED=EXPLICITLY_AUTHORIZED
export RESIZE_PRODUCT_MODE=PRODUCTION
export RESIZE_DATA_NAMESPACE=PRODUCTION
export RESIZE_KEY_SETUP_ONLY=0
export RESIZE_FAKE_MODE=0
exec /bin/zsh "$SCRIPT_DIR/scripts/launch-production.zsh"
